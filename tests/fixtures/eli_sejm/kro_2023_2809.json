{"act":{"announcementDate":"1964-02-25","displayAddress":"Dz.U. 1964 nr 9 poz. 59","entryIntoForce":"1965-01-01","title":"Ustawa z dnia 25 lutego 1964 r. - Kodeks rodzinny i opiekuńczy.","type":"Ustawa"},"act_id":"DU/1964/59","kind":"consolidated_text","schema":"ulis-pl-eli-bundle/1","text_html":"<!DOCTYPE HTML>\n<html lang=\"pl\">\n   <head>\n      <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8; charset=UTF-8\">\n      <meta name=\"charset\" content=\"utf-8\">\n      <link rel=\"stylesheet\" type=\"text/css\" href=\"/act.css\">\n   </head>\n   <body>\n      <h1><span class=\"head-type\">Obwieszczenie Marszałka Sejmu Rzeczypospolitej Polskiej</span><span class=\"head-date\">z dnia 7 grudnia 2023&nbsp;r.</span><span class=\"head-title\">w sprawie ogłoszenia jednolitego tekstu ustawy - Kodeks rodzinny i opiekuńczy</span></h1>\n      <div class=\"parts\">\n<section id=\"part_2\">\n<div class=\"part\" id=\"_002\">\n<h2 class=\"part\"><span class=\"   \">Załącznik</span>\n               \t\t\t\t\t\t&nbsp;&nbsp;-&nbsp;&nbsp;\n               \t\t\t\t\t\tTekst jednolity ustawy z dnia 25 lutego 1964&nbsp;r. Kodeks rodzinny i opiekuńczy\n            </h2>\n<div class=\"block\">\n<div class=\"unit unit_titl pro-text with-title\" id=\"titl_I\" data-id=\"titl_I\" data-bookmark=\"_002_z1_a1\">\n                  <h3>\n                     <P ALIGN=\"center\">\n                        &nbsp;&nbsp;\n                        Tytuł&nbsp;I\n                        &nbsp;&nbsp;\n                        \n                     </P>\n                     <P ALIGN=\"center\"><B CLASS=\"b\"><SPAN CLASS=\"pro-title-unit\">Małżeństwo</SPAN></B></P>\n                  </h3>\n                  <div class=\"unit-inner\">\n                     \n                     \n                     \n                     <div class=\"unit unit_bran pro-text with-title\" id=\"titl_I-bran_II\" data-id=\"bran_II\" data-bookmark=\"_002_z1_a23\">\n                        <h3>\n                           <P ALIGN=\"center\">\n                              &nbsp;&nbsp;\n                              Dział&nbsp;II\n                              &nbsp;&nbsp;\n                              \n                           </P>\n                           <P ALIGN=\"center\"><B CLASS=\"b\"><SPAN CLASS=\"pro-title-unit\">Prawa i obowiązki małżonków</SPAN></B></P>\n                        </h3>\n                        <div class=\"unit-inner\">\n                           \n                           \n                           \n                           <div class=\"unit unit_arti pro-text false\" id=\"titl_I-bran_II-arti_23\" data-id=\"arti_23\">\n                              <h3 CLASS=\"pro-none\"><B CLASS=\"b\">Art.&nbsp;23.</B></h3>\n                              <div class=\"unit-inner\">\n                                 \n                                 <div data-template=\"xText\" CLASS=\"pro-text\">Małżonkowie mają równe prawa i obowiązki w małżeństwie. Są obowiązani do wspólnego\n                                    pożycia, do wzajemnej pomocy i wierności oraz do współdziałania dla dobra rodziny,\n                                    którą przez swój związek założyli.\n                                 </div>\n                              </div>\n                           </div>\n                           \n                        </div>\n                     </div>\n                     \n                  </div>\n               </div><div class=\"unit unit_titl pro-text with-title\" id=\"titl_II\" data-id=\"titl_II\" data-bookmark=\"_002_z1_a61_7\">\n                  <h3>\n                     <P ALIGN=\"center\">\n                        &nbsp;&nbsp;\n                        Tytuł&nbsp;II\n                        &nbsp;&nbsp;\n                        \n                     </P>\n                     <P ALIGN=\"center\"><B CLASS=\"b\"><SPAN CLASS=\"pro-title-unit\">Pokrewieństwo i powinowactwo</SPAN></B></P>\n                  </h3>\n                  <div class=\"unit-inner\">\n                     \n                     \n                     \n                     <div class=\"unit unit_bran pro-text with-title\" id=\"titl_II-bran_IA\" data-id=\"bran_IA\" data-bookmark=\"_002_z1_a61_9\">\n                        <h3>\n                           <P ALIGN=\"center\">\n                              &nbsp;&nbsp;\n                              Dział&nbsp;IA\n                              &nbsp;&nbsp;\n                              \n                           </P>\n                           <P ALIGN=\"center\"><B CLASS=\"b\"><SPAN CLASS=\"pro-title-unit\">Rodzice i dzieci</SPAN></B></P>\n                        </h3>\n                        <div class=\"unit-inner\">\n                           \n                           \n                           \n                           <div class=\"unit unit_chpt pro-text with-title\" id=\"titl_II-bran_IA-chpt_II\" data-id=\"chpt_II\" data-bookmark=\"_002_z1_a87\">\n                              <h3>\n                                 <P ALIGN=\"center\">\n                                    &nbsp;&nbsp;\n                                    Rozdział&nbsp;II\n                                    &nbsp;&nbsp;\n                                    \n                                 </P>\n                                 <P ALIGN=\"center\"><B CLASS=\"b\"><SPAN CLASS=\"pro-title-unit\">Stosunki między rodzicami a dziećmi</SPAN></B></P>\n                              </h3>\n                              <div class=\"unit-inner\">\n                                 \n                                 \n                                 \n                                 <div class=\"unit unit_schp pro-text with-title\" id=\"titl_II-bran_IA-chpt_II-schp_2\" data-id=\"schp_2\" data-bookmark=\"_002_z1_a92\">\n                                    <h3>\n                                       <P ALIGN=\"center\">\n                                          &nbsp;&nbsp;\n                                          Oddział&nbsp;2\n                                          &nbsp;&nbsp;\n                                          \n                                       </P>\n                                       <P ALIGN=\"center\"><B CLASS=\"b\"><SPAN CLASS=\"pro-title-unit\">Władza rodzicielska</SPAN></B></P>\n                                    </h3>\n                                    <div class=\"unit-inner\">\n                                       \n                                       \n                                       \n                                       <div class=\"unit unit_arti pro-text false\" id=\"titl_II-bran_IA-chpt_II-schp_2-arti_99_2_a\" data-id=\"arti_99_2_a\" data-bookmark=\"_002_z1_a99_2a\">\n                                          <h3 CLASS=\"pro-none\"><B CLASS=\"b\">Art.&nbsp;99<SUP>2</SUP><SUP>a</SUP><A class=\"gloss-link tooltip\" href=\"#gloss-0:3:\"><sup>3)</sup><span class=\"tooltip-text\"><span class=\"pro-gloss-inner\">Dodany przez art. 1 pkt 2 ustawy, o której mowa w odnośniku 2; wszedł w życie z dniem\n                                                         29 sierpnia 2023&nbsp;r.</span></span></A>.</B></h3>\n                                          <div class=\"unit-inner\">\n                                             \n                                             <div class=\"unit unit_para pro-text false\" id=\"titl_II-bran_IA-chpt_II-schp_2-arti_99_2_a-para_1\" data-id=\"para_1\" data-bookmark=\"_002_z1_a99_2a_p1\">\n                                                <h3 CLASS=\"pro-padding-right\"><B CLASS=\"b\">§&nbsp;1.</B></h3>\n                                                <div class=\"unit-inner\">\n                                                   \n                                                   <div data-template=\"xText\" CLASS=\"pro-text\">Nad działalnością reprezentanta dziecka czuwa sąd opiekuńczy, zaznajamiając się na\n                                                      bieżąco z jego działalnością.\n                                                   </div>\n                                                </div>\n                                             </div>\n                                             \n                                             <div class=\"unit unit_para pro-text false\" id=\"titl_II-bran_IA-chpt_II-schp_2-arti_99_2_a-para_2\" data-id=\"para_2\" data-bookmark=\"_002_z1_a99_2a_p2\">\n                                                <h3 CLASS=\"pro-padding-right\"><B CLASS=\"b\">§&nbsp;2.</B></h3>\n                                                <div class=\"unit-inner\">\n                                                   \n                                                   <div data-template=\"xText\" CLASS=\"pro-text\">Reprezentant dziecka składa sądowi opiekuńczemu w wyznaczonych terminach, nie rzadziej\n                                                      niż co cztery miesiące, informacje dotyczące jego działalności, w szczególności o\n                                                      dokonywanych wszelkich czynnościach łączących się ze sprawą oraz obowiązkach określonych\n                                                      w art. 99<SUP>2</SUP>.\n                                                   </div>\n                                                </div>\n                                             </div>\n                                             \n                                          </div>\n                                       </div>\n                                       \n                                    </div>\n                                 </div>\n                                 \n                              </div>\n                           </div>\n                           \n                        </div>\n                     </div>\n                     \n                  </div>\n               </div>\n</div>\n</div>\n<div class=\"gloss-section\"></div>\n</section>\n</div>\n</body>\n</html>\n","tj_id":"DU/2023/2809","tj_record":{"ELI":"DU/2023/2809","address":"WDU20230002809","announcementDate":"2023-12-07","authorizedBody":[],"changeDate":"2026-03-02T11:04:53","directives":[],"displayAddress":"Dz.U. 2023 poz. 2809","expirationDate":"2026-02-27","inForce":"NOT_IN_FORCE","keywords":["kodeks rodzinny i opiekuńczy"],"keywordsNames":[],"legalStatusDate":"2023-12-06","obligated":[],"pos":2809,"previousTitle":[],"prints":[],"promulgation":"2023-12-29","publisher":"DU","references":{"Podstawa prawna":[{"id":"DU/2000/718"}],"Podstawa prawna z art.":[{"art":"art. 16 ust. 1 zdanie pierwsze","id":"DU/2000/718"}],"Tekst jednolity dla aktu":[{"id":"DU/1964/59"}]},"releasedBy":["MARSZAŁEK SEJMU"],"status":"wygaśnięcie aktu","textHTML":true,"textPDF":true,"texts":[{"fileName":"text.html","type":"H"},{"fileName":"D20232809.pdf","type":"O"},{"fileName":"D20232809.pdf","type":"I"},{"fileName":"D20232809L.pdf","type":"T"},{"fileName":"D20232809Lj.pdf","type":"U"}],"title":"Obwieszczenie Marszałka Sejmu Rzeczypospolitej Polskiej z dnia 7 grudnia 2023 r. w sprawie ogłoszenia jednolitego tekstu ustawy - Kodeks rodzinny i opiekuńczy","type":"Obwieszczenie","volume":0,"year":2023},"urls":{"record":"https://api.sejm.gov.pl/eli/acts/DU/2023/2809","text":"https://api.sejm.gov.pl/eli/acts/DU/2023/2809/text.html"}}