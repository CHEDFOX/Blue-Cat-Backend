    <body period="#tg_eif">
      <article eId="art_1">
        <num>1</num>
        <heading>Purpose</heading>
        <content><p>This Convention establishes common minimum standards for the protection of individuals when personal data concerning them are processed.</p></content>
      </article>
      <article eId="art_5">
        <num>5</num>
        <heading>Storage limitation</heading>
        <paragraph eId="art_5__para_1">
          <num>1.</num>
          <content><p>Each Party shall ensure that personal data are kept for no longer than is necessary for the purposes for which they are processed.</p></content>
        </paragraph>
        <paragraph eId="art_5__para_2">
          <num>2.</num>
          <content><p>Each Party shall provide an effective remedy by which an individual may obtain the erasure of personal data kept in breach of paragraph 1.</p></content>
        </paragraph>
      </article>
      <article eId="art_20">
        <num>20</num>
        <heading>Entry into force</heading>
        <content><p>This Convention enters into force on the first day of the month following the deposit of the second instrument of ratification.</p></content>
      </article>
