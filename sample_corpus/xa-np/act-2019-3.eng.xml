    <body period="#tg_2019">
      <section eId="sec_1">
        <num>1</num>
        <heading>Short title and commencement</heading>
        <content><p>This Act may be cited as the Health Records Act 2019 and comes into force on 1 September 2019.</p></content>
      </section>
      <section eId="sec_5">
        <num>5</num>
        <heading>Access to health records</heading>
        <subsection eId="sec_5__subsec_1">
          <num>(1)</num>
          <content><p>A patient may request access to any health record held about the patient by a health provider in the Province.</p></content>
        </subsection>
        <subsection eId="sec_5__subsec_2">
          <num>(2)</num>
          <content><p>A health provider shall give access within fifteen days after receiving a request.</p></content>
        </subsection>
      </section>
      <section eId="sec_6">
        <num>6</num>
        <heading>Retention of health records</heading>
        <subsection eId="sec_6__subsec_1">
          <num>(1)</num>
          <content><p>A health provider shall keep a health record for at least ten years after the patient's last treatment.</p></content>
        </subsection>
        <subsection eId="sec_6__subsec_2">
          <num>(2)</num>
          <content><p>The duty in subsection (1) applies despite <ref href="/akn/xa/act/2015/12/~sec_12" ulis:relation="cites">section 12 of the Personal Data Act 2015</ref>.</p></content>
        </subsection>
      </section>
