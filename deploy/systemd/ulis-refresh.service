# Weekly refresh of the corpus (see ulis-refresh.timer). Re-runs `load-all` for the LIVE sources only: those whose
# publisher keeps changing the text. Static pins (a fixed commit, release point or explicit version list, see
# ulis/ops/sources.py STATIC_PINS) are skipped: they change only when you edit their manifest.
# Cached downloads older than 7 days are discarded first, so the run re-fetches (politely, at each source's crawl
# delay) and only NEW or CHANGED texts become new point-in-time versions. A big source such as the German federal
# laws is thousands of requests; make it monthly by adding `--skip de-gesetze-im-internet` here and running it
# yourself, or raise --max-cache-age-days.
# Exit status is non-zero when any source errored: `systemctl --failed` / journalctl show it.
# Adding `--prune-cache` to the command keeps the download cache empty between refreshes at almost no extra network
# cost (a refresh re-fetches files older than 7 days anyway; not so with a larger --max-cache-age-days): after a run in which no source failed it verifies the new
# documents and deletes the cached downloads of the sources whose documents all pass (docs/deployment.md section 13).
[Unit]
Description=ULIS corpus refresh (live sources)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ulis/deploy
ExecStart=/usr/bin/docker compose --project-directory /opt/ulis/deploy -f /opt/ulis/deploy/docker-compose.yml --profile tools run --rm -T cli load-all --refresh --max-cache-age-days 7
# A refresh can take many hours.
TimeoutStartSec=infinity
Nice=10
